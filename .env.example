# --- Browser-safe (the anon key is public by design; Row-Level Security is what protects data) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Deployment switches (server-side, optional; both default to on) ---
# SIGNUPS_ENABLED=false     close the sign-up form (also disable sign-ups in the Supabase project)
# DEMO_ENABLED=false        hide the "Try the demo" button

# --- Seed/reset scripts ONLY. Keep in .env.local / .env.hosted (gitignored). NEVER set on Vercel. ---
SUPABASE_SERVICE_ROLE_KEY=
